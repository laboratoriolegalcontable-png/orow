# Fase 8 - Productividad interna (Wiki.js + Firefly III + Planka)

WIKIJS_PORT=3300
WIKIJS_DB_PASSWORD=CHANGE_ME_generate_with_openssl

FIREFLYIII_PORT=8060
FIREFLYIII_URL=http://localhost:8060
FIREFLYIII_DB_PASSWORD=CHANGE_ME_generate_with_openssl
# Formato especial requerido por Firefly III (Laravel APP_KEY): "base64:" + 32 bytes en base64.
# Generar con: echo "base64:$(openssl rand -base64 32)"
FIREFLYIII_APP_KEY=CHANGE_ME_see_comment_above

# Planka: Kanban SOLO para proyectos/desarrollos inmobiliarios - no para
# expedientes judiciales (eso vive en OroGest/NARAKIA, Supabase).
PLANKA_PORT=3400
PLANKA_URL=http://localhost:3400
PLANKA_DB_PASSWORD=CHANGE_ME_generate_with_openssl
PLANKA_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
# DEFAULT_ADMIN_* solo se usan para crear el primer admin al arrancar -
# sacarlas de .env despues del primer login (ver docs/FASE-8-productividad.md).
PLANKA_ADMIN_EMAIL=admin@estudiooro.com.ar
PLANKA_ADMIN_USERNAME=admin
PLANKA_ADMIN_NAME=Estudio Oro
PLANKA_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl
