# Fase 5 - Marketing (opcion ligera: n8n + Matomo)
N8N_PORT=5678
N8N_HOST=localhost
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_generate_with_openssl

# Usado por n8n-workflows/backup-watchdog.json - webhook de Make.com (u otro
# medio) donde avisar si un backup de Duplicati falla. Ver n8n-workflows/README.md
ALERTA_WHATSAPP_WEBHOOK_URL=https://reemplazar-con-el-webhook-real

MATOMO_PORT=8050
MATOMO_DB_PASSWORD=CHANGE_ME_generate_with_openssl
MATOMO_DB_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl

# Solo si se usa el overlay docker-compose.mautic.yml (>4GB RAM libres)
MAUTIC_PORT=8012
MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl
MAUTIC_DB_PASSWORD=CHANGE_ME_generate_with_openssl
