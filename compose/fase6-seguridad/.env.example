# Fase 6 - Seguridad, cumplimiento y facturacion

# Authentik: correr ./generate-authentik-secrets.sh antes de docker compose up,
# NO usar los valores de ejemplo de abajo.
AUTHENTIK_PORT=9000
AUTHENTIK_SECRET_KEY=CHANGE_ME_run_generate-authentik-secrets.sh
AUTHENTIK_DB_PASSWORD=CHANGE_ME_generate_with_openssl
AUTHENTIK_BOOTSTRAP_EMAIL=admin@estudiooro.com.ar
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_generate_with_openssl

VAULTWARDEN_PORT=8001
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_generate_with_openssl
# DOMAIN debe coincidir con la URL real desde la que se accede (Vaultwarden
# rechaza signup/login si no reconoce el origen como el DOMAIN configurado).
# Con tunel SSH local (ssh -L 8080:localhost:8001 ...): dejar el default.
# Detras de Nginx Proxy Manager con dominio propio: cambiar a esa URL https.
VAULTWARDEN_DOMAIN=http://localhost:8080
# Dejar en "true" SOLO durante la creacion de la primera cuenta, despues
# volver a "false" y reiniciar el contenedor - nadie mas deberia poder
# registrarse.
VAULTWARDEN_SIGNUPS_ALLOWED=false

DUPLICATI_PORT=8200
DUPLICATI_SETTINGS_KEY=CHANGE_ME_generate_with_openssl
DUPLICATI_WEB_PASSWORD=CHANGE_ME_generate_with_openssl

SYNCTHING_GUI_PORT=8384
